import { getDatabase } from "@netlify/database";
import { fetchText, htmlToText } from "./http.mts";
import { PHYSICAL_SOURCES, type SourceDefinition } from "./sources.mts";

async function markSource(db:any, source:SourceDefinition, ok:boolean, hash?:string, error?:string) {
  if (ok) await db.sql`UPDATE sources SET last_checked_at=NOW(),last_success_at=NOW(),health='healthy',failure_count=0,last_hash=${hash||null},last_error=NULL,parser_version=${source.parserVersion},monitoring_mode=${source.monitoringMode},last_changed_at=CASE WHEN last_hash IS DISTINCT FROM ${hash||null} THEN NOW() ELSE last_changed_at END WHERE id=${source.id}`;
  else await db.sql`UPDATE sources SET last_checked_at=NOW(),failure_count=failure_count+1,health=CASE WHEN failure_count>=2 THEN 'failing' ELSE 'degraded' END,last_error=${error||"Unknown fetch error"},parser_version=${source.parserVersion},monitoring_mode=${source.monitoringMode} WHERE id=${source.id}`;
}
async function updateSystem(db:any,id:string,status:string,label:string,detail:string){ await db.sql`UPDATE systems SET status=${status},status_label=${label},status_detail=${detail},last_checked_at=NOW() WHERE id=${id}`; }
async function upsertEvent(db:any,event:any){ await db.sql`INSERT INTO events (id,system_id,country_code,country_name,region,event_type,status,severity,confidence,title,summary,operational_impact,workaround,starts_at,ends_at,all_day,source_name,source_url,source_tier,last_verified_at,fingerprint) VALUES (${event.id},${event.systemId},${event.countryCode},${event.countryName},${event.region},${event.eventType},'upcoming',${event.severity},'official',${event.title},${event.summary},${event.impact},${event.workaround},${event.startsAt},${event.endsAt||null},${event.allDay||false},${event.sourceName},${event.sourceUrl},1,NOW(),${event.id}) ON CONFLICT (id) DO UPDATE SET title=EXCLUDED.title,summary=EXCLUDED.summary,operational_impact=EXCLUDED.operational_impact,workaround=EXCLUDED.workaround,starts_at=EXCLUDED.starts_at,ends_at=EXCLUDED.ends_at,all_day=EXCLUDED.all_day,last_verified_at=NOW(),updated_at=NOW(),resolved_at=NULL`; }
async function resolvePrefix(db:any,prefix:string,keep:string[]){ const rows=await db.sql`SELECT id FROM events WHERE id LIKE ${prefix+'%'} AND resolved_at IS NULL`; for(const row of rows as any[]) if(!keep.includes(row.id)) await db.sql`UPDATE events SET resolved_at=NOW(),status='resolved',updated_at=NOW() WHERE id=${row.id}`; }
function localYmdTurkey(now=new Date()){ const parts=new Intl.DateTimeFormat("en-CA",{timeZone:"Europe/Istanbul",year:"numeric",month:"2-digit",day:"2-digit"}).formatToParts(now); const get=(t:string)=>parts.find(p=>p.type===t)?.value||""; return `${get("year")}-${get("month")}-${get("day")}`; }
function turkeyLocalToUtc(date:string,time:string){ const [y,m,d]=date.split("-").map(Number); const [hh,mm]=time.split(":").map(Number); return new Date(Date.UTC(y,m-1,d,hh-3,mm)); }
function extractSuspensions(plain:string,strait:"Istanbul Strait"|"Canakkale Strait"){ const start=plain.indexOf(strait); if(start<0)return [] as Array<{direction:string;start:string;end:string}>; const endName=strait==="Istanbul Strait"?"Canakkale Strait":null; const end=endName?plain.indexOf(endName,start+strait.length):-1; const block=plain.slice(start,end>start?end:undefined); const directions=["NORTH-SOUTH","SOUTH-NORTH"]; const out:Array<{direction:string;start:string;end:string}>=[]; for(let i=0;i<directions.length;i++){ const d=directions[i],pos=block.indexOf(d); if(pos<0)continue; const next=i+1<directions.length?block.indexOf(directions[i+1],pos+d.length):-1; const section=block.slice(pos,next>pos?next:undefined); for(const m of section.matchAll(/(\d{2}:\d{2})\s*-\s*(\d{2}:\d{2})\s+Askıya Alma\s*\(Suspension\)/gi)) out.push({direction:d,start:m[1],end:m[2]}); } return out; }
async function refreshTurkishStraits(db:any,source:SourceDefinition,html:string){ const plain=htmlToText(html); if(!/Istanbul Strait/i.test(plain)||!/Canakkale Strait/i.test(plain)||!/Traffic Open/i.test(plain)) throw new Error("Turkish Straits traffic page structure not recognized"); const date=localYmdTurkey(); const windows=[...extractSuspensions(plain,"Istanbul Strait").map(w=>({...w,strait:"Istanbul Strait"})),...extractSuspensions(plain,"Canakkale Strait").map(w=>({...w,strait:"Canakkale Strait"}))]; const keep:string[]=[]; for(const w of windows){ let start=turkeyLocalToUtc(date,w.start),end=turkeyLocalToUtc(date,w.end); if(end<=start)end=new Date(end.getTime()+86400000); const id=`tr-straits-${w.strait.startsWith("Istanbul")?"istanbul":"canakkale"}-${w.direction==="NORTH-SOUTH"?"ns":"sn"}-${date.replaceAll("-","")}-${w.start.replace(":","")}`; keep.push(id); await upsertEvent(db,{id,systemId:source.system,countryCode:"TR",countryName:"Türkiye",region:"Europe",eventType:"traffic_suspension",severity:"limited",title:`${w.strait} ${w.direction.toLowerCase()} transit suspension`,summary:`The official Turkish Straits traffic schedule lists ${w.strait} ${w.direction.toLowerCase()} transit as suspended from ${w.start} to ${w.end} local time.`,impact:"Vessels travelling in the affected direction cannot transit the strait during the published window.",workaround:"Plan arrival around the published directional opening windows and re-check the official traffic schedule before transit.",startsAt:start.toISOString(),endsAt:end.toISOString(),sourceName:"Directorate General of Coastal Safety — Turkish Straits Traffic",sourceUrl:source.url}); } await resolvePrefix(db,"tr-straits-",keep); await updateSystem(db,source.system,"clear","Traffic schedule live",windows.length?`Official traffic windows are published for today; ${windows.length} directional suspension ${windows.length===1?"window is":"windows are"} listed across the Istanbul and Çanakkale straits.`:"Official traffic windows are published for today; no suspension window was parsed."); }
async function refreshSuez(db:any,source:SourceDefinition,html:string){ const plain=htmlToText(html); if(!/Suez Canal Authority/i.test(plain)||!/Navigation/i.test(plain)) throw new Error("Suez Canal Authority homepage structure not recognized"); const recent=plain.slice(0,12000); const closure=/navigation (?:is |was )?(?:suspended|halted)|canal (?:is |was )?closed|traffic (?:is |was )?suspended/i.test(recent); const normal=/traffic through the Canal is flowing normally|traffic through the canal.*regular|continues to provide its navigational services|traffic.*witnessed the transit/i.test(recent); if(closure) await updateSystem(db,source.system,"outage","Navigation disruption","The current Suez Canal Authority feed contains language indicating a navigation suspension or canal closure. Open the official source for the latest scope and timing."); else if(normal) await updateSystem(db,source.system,"clear","Navigation operating","Recent official Suez Canal Authority navigation updates show traffic continuing. This is bulletin monitoring, not a continuous operational heartbeat."); else await updateSystem(db,source.system,"unknown","Status needs review","The Suez Canal Authority feed loaded, but TradeStatus could not determine current navigation state confidently."); }
function borderWaitRows(html:string){ const rows=[...html.matchAll(/<tr\b[^>]*>([\s\S]*?)<\/tr>/gi)].map(m=>htmlToText(m[1])); return rows.filter(r=>/\b(?:Commercial|hrs\/day|am-|pm-|Midnight|lanes open|Update Pending|Lanes Closed)\b/i.test(r)); }
function commercialDelay(row:string){ const m=row.match(/At\s+[^,|]{1,40}?\s+(\d{1,3})\s+min delay\s+(\d{1,2})\s+lanes? open/i); if(m)return{minutes:+m[1],lanes:+m[2]}; const none=row.match(/At\s+[^,|]{1,40}?\s+no delay\s+(\d{1,2})\s+lanes? open/i); if(none)return{minutes:0,lanes:+none[1]}; return null; }
async function refreshBorderWaits(db:any,source:SourceDefinition,html:string){ const plain=htmlToText(html); if(!/Border Wait Times/i.test(plain)||!/Commercial Vehicles/i.test(plain)) throw new Error("CBP Border Wait Times table structure not recognized"); const rows=borderWaitRows(html); let parsed=0; const severe:string[]=[]; let pending=0; for(const row of rows){ if(/Update Pending/i.test(row)){pending+=1;continue;} const delay=commercialDelay(row); if(!delay)continue; parsed+=1; if(delay.minutes>60)severe.push(row.slice(0,180)); } if(parsed===0&&pending===0) throw new Error("CBP commercial wait rows were not parsed"); const id="us-border-commercial-delay-live"; if(severe.length){ await upsertEvent(db,{id,systemId:source.system,countryCode:"US",countryName:"United States",region:"Americas",eventType:"border_delay",severity:"moderate",title:"Commercial border waits above 60 minutes",summary:`CBP reports commercial-vehicle waits above 60 minutes at ${severe.length} monitored border crossing ${severe.length===1?"row":"rows"}.`,impact:"Longer commercial processing times may delay cross-border truck movements at affected ports of entry.",workaround:"Check CBP Border Wait Times for the affected crossing and consider alternate ports or arrival windows where operationally feasible.",startsAt:new Date().toISOString(),endsAt:null,sourceName:"U.S. Customs and Border Protection — Border Wait Times",sourceUrl:source.url}); await updateSystem(db,source.system,"degraded","Elevated commercial waits",`CBP currently reports commercial waits above 60 minutes in ${severe.length} parsed crossing ${severe.length===1?"row":"rows"}.`); } else { await db.sql`UPDATE events SET resolved_at=COALESCE(resolved_at,NOW()),status='resolved',updated_at=NOW(),last_verified_at=NOW() WHERE id=${id} AND resolved_at IS NULL`; await updateSystem(db,source.system,"clear","No >60 min delay parsed",`CBP commercial border data loaded; ${parsed} current wait ${parsed===1?"row was":"rows were"} parsed and none exceeded 60 minutes.${pending?` ${pending} rows reported “Update Pending”.`:""}`); } }
async function due(db:any,force:boolean){ if(force)return PHYSICAL_SOURCES; const ids=PHYSICAL_SOURCES.map(s=>s.id); const rows=await db.sql`SELECT id,last_checked_at,poll_interval_minutes FROM sources WHERE id = ANY(${ids})`; const byId=new Map(rows.map((r:any)=>[r.id,r])); const now=Date.now(); return PHYSICAL_SOURCES.filter(s=>{const r:any=byId.get(s.id);return !r?.last_checked_at||now-new Date(r.last_checked_at).getTime()>=Number(r.poll_interval_minutes||s.pollMinutes)*60000*.9;}); }
export async function refreshPhysicalSources(force=false){ const db=getDatabase(); const sources=await due(db,force); if(!sources.length)return[{source:"physical-scheduler",ok:true,skipped:true}]; const results=await Promise.allSettled(sources.map(async source=>{ try{ const {text,hash}=await fetchText(source.url,12000); if(source.adapter==="tr_straits")await refreshTurkishStraits(db,source,text); else if(source.adapter==="eg_suez")await refreshSuez(db,source,text); else if(source.adapter==="us_bwt")await refreshBorderWaits(db,source,text); else throw new Error(`Unknown physical adapter: ${source.adapter}`); await markSource(db,source,true,hash); return{source:source.id,ok:true}; }catch(error){ const message=error instanceof Error?error.message:String(error); await markSource(db,source,false,undefined,message); throw new Error(`${source.id}: ${message}`); } })); return results.map((r,i)=>r.status==="fulfilled"?r.value:{source:sources[i].id,ok:false,error:r.reason instanceof Error?r.reason.message:String(r.reason)}); }
